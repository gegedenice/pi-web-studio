# PI Studio, test local : copier ce fichier en .env (le .env n'est jamais commité).

# Mot de passe de connexion à Pi Web et au Studio.
# Vide = pas de mot de passe : acceptable uniquement en local (port publié sur 127.0.0.1).
PI_WEB_PASSWORD=

# Identité enregistrée comme autrice des versions, faute de proxy d'authentification.
# Doit correspondre à une entrée de docker/studio-users.dev.json pour avoir un nom complet.
STUDIO_DEFAULT_USER=geraldine

# Clé d'API de llama.cpp, seulement si llama-server est lancé avec --api-key.
# models.json peut y faire référence par "apiKey": "$LLAMA_API_KEY".
LLAMA_API_KEY=

# Jetons des serveurs MCP (lot 3) : le Studio n'enregistre dans le pack que le nom
# de la variable ("Authorization": "Bearer ${OPENALEX_TOKEN}"), jamais la valeur.
# OPENALEX_TOKEN=
