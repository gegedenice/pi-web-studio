# PI Studio sur un serveur (compose.vps.yml) : copier ce fichier en .env sur le
# serveur, à côté de compose.vps.yml. Le .env n'est jamais commité.
# Procédure : docs/studio/DEPLOY-VPS.md

# Nom public du Studio : la route de Traefik et le nom d'hôte que pi-web accepte.
STUDIO_DOMAIN=pi-web-studio.example.fr

# Où vivent les données sur le serveur (dépôt des packs, dossier de Pi, liste des personnes) : à sauvegarder.
STUDIO_DATA_DIR=/srv/pi-studio-data

# Authentification basique (Traefik) : une entrée par personne, séparées par des
# virgules. Chaque entrée est la ligne COMPLÈTE qu'affiche
#   docker run --rm httpd:2.4-alpine htpasswd -nbB geraldine 'son-mot-de-passe'
# soit « geraldine: » suivi d'une empreinte de 60 caractères qui commence par $2y$.
# Jamais le mot de passe en clair : Traefik refuse alors toute la configuration
# du conteneur (« error parsing BasicUser ») et le site répond 404.
# Gardez les guillemets SIMPLES : sans eux, Docker Compose lirait les $ comme des
# variables. Les identifiants doivent être ceux de studio-users.json.
STUDIO_BASIC_AUTH_USERS='geraldine:EMPREINTE-HTPASSWD,bibliothecaire-1:EMPREINTE-HTPASSWD'

# Mot de passe propre à Pi Web, seconde barrière : les autres conteneurs du
# réseau « web » atteignent le Studio sans passer par Traefik. Long et aléatoire.
# Demandé une fois par navigateur, puis retenu 30 jours.
PI_WEB_PASSWORD=

# Identité si aucun identifiant n'arrive au Studio (ne devrait pas arriver derrière Traefik).
STUDIO_DEFAULT_USER=studio

# Jetons des serveurs MCP : les packs ne contiennent que le nom de la variable
# ("Authorization": "Bearer ${HAL_TOKEN}").
# HAL_TOKEN=
# Clé d'un provider LLM, si models.json y fait référence ("apiKey": "$LLAMA_API_KEY").
# LLAMA_API_KEY=
